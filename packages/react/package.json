{
  "name": "@morehao/ark-iam-react",
  "version": "0.3.1",
  "type": "module",
  "description": "GoArk IAM 前端门面包：聚合 @ark-iam/{types,api,auth,ui} 的单一入口（含 ESM 子路径导出，可按需引入）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morehao/ark-iam.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/morehao/ark-iam/tree/main/packages/react",
  "bugs": {
    "url": "https://github.com/morehao/ark-iam/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    },
    "./login": {
      "types": "./dist/login.d.ts",
      "import": "./dist/login.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build --config vite.config.lib.ts && tsc -p tsconfig.build.json && node scripts/bundle-dts.mjs",
    "pack:dist": "pnpm build && pnpm pack",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@ant-design/icons": "^6.3.4",
    "antd": "^6.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.15.0"
  },
  "peerDependenciesMeta": {
    "antd": {
      "optional": true
    },
    "@ant-design/icons": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "axios": "^1.7.0",
    "oidc-client-ts": "^3.5.0",
    "react-oidc-context": "^3.3.1"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ark-iam/api": "workspace:*",
    "@ark-iam/auth": "workspace:*",
    "@ark-iam/login": "workspace:*",
    "@ark-iam/tsconfig": "workspace:*",
    "@ark-iam/types": "workspace:*",
    "@ark-iam/ui": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "antd": "^6.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.15.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.10"
  }
}
