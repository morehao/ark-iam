{
  "name": "@ark-iam/install",
  "version": "1.0.0",
  "type": "module",
  "description": "GoArk IAM /install 初始化协议包（契约类型 + 向导表单 + 错误映射 + status/initialize 调用），从 @ark-iam/login 拆出",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build --config vite.config.lib.ts && tsc -p tsconfig.build.json",
    "pack:dist": "pnpm build && pnpm pack",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ark-iam/login": "workspace:*",
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "@ark-iam/tsconfig": "workspace:*",
    "typescript": "^5.6.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
