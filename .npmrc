shamefully-hoist=true

# 发布门面包 @morehao/ark-iam-react 时，registry 按 scope @morehao 配置（P0 T7）。
# 发公共 npm（默认 registry）通常无需本段；以下是私有 registry / GitHub Packages 示例，按需取消注释。
# GitHub Packages 示例（scope 必须带 @）：
# @morehao:registry=https://npm.pkg.github.com
# //npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
# 私有 npm（Verdaccio/Nexus 等）示例：
# @morehao:registry=https://npm.example.com/repository/npm-private/
# //npm.example.com/repository/npm-private/:_authToken=${NPM_TOKEN}
