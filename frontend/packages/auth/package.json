{
  "name": "@ark-iam/auth",
  "version": "1.0.0",
  "type": "module",
  "description": "GoArk IAM OIDC 认证 Provider 与 hooks",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build --config vite.config.lib.ts && tsc -p tsconfig.build.json",
    "pack:dist": "pnpm build && pnpm pack",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "antd": "^6.7.0",
    "react": "^19.3.1",
    "react-router-dom": "^7.15.0"
  },
  "dependencies": {
    "@ark-iam/api": "workspace:*",
    "@ark-iam/types": "workspace:*",
    "oidc-client-ts": "^3.5.0",
    "react-oidc-context": "^3.3.1"
  },
  "devDependencies": {
    "@ark-iam/tsconfig": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "antd": "^6.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.15.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
