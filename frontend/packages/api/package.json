{
  "name": "@ark-iam/api",
  "version": "1.0.0",
  "type": "module",
  "description": "GoArk IAM 业务 API 客户端（axios 封装 + 资源方法）",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build --config vite.config.lib.ts && tsc -p tsconfig.build.json",
    "pack:dist": "pnpm build && pnpm pack",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "antd": "^5.22.0",
    "react": "^18.3.1",
    "react-oidc-context": "^3.3.1"
  },
  "dependencies": {
    "@ark-iam/types": "workspace:*",
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "@ark-iam/tsconfig": "workspace:*",
    "@types/react": "^18.3.0",
    "antd": "^5.22.0",
    "react": "^18.3.1",
    "react-oidc-context": "^3.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
