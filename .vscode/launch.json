    "version": "0.2.0",
    "configurations": [
        {
            "name": "ark-iam: auth",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/backend/apps/auth/cmd",
            "cwd": "${workspaceFolder}/backend",
            "env": {
                "APP_CONFIG_PATH": "${workspaceFolder}/backend/apps/auth/config/config.yaml"
            }
        },
        {
            "name": "ark-iam: platformadmin",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/backend/apps/platformadmin/cmd",
            "cwd": "${workspaceFolder}/backend",
            "env": {
                "APP_CONFIG_PATH": "${workspaceFolder}/backend/apps/platformadmin/config/config.yaml"
            }
        },
        {
            "name": "ark-iam: tenantadmin",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/backend/apps/tenantadmin/cmd",
            "cwd": "${workspaceFolder}/backend",
            "env": {
                "APP_CONFIG_PATH": "${workspaceFolder}/backend/apps/tenantadmin/config/config.yaml"
            }
        },
        {
            "name": "ark-iam: gateway",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/backend/apps/gateway/cmd",
            "cwd": "${workspaceFolder}/backend",
            "env": {
                "APP_CONFIG_PATH": "${workspaceFolder}/backend/apps/gateway/config/config.yaml"
            }
        }
    ]
}
